# Second Brain - Git Ignore
# Keeps your personal notes private while sharing the system

# ============================================================
# PERSONAL CONTENT - Never commit (at vault root)
# ============================================================

# Personal note folders
/.Archive/
/Lists/
/Memos/
/Wisdom/
/Conversations/
/Tasks/
/Shopping/
/Contacts/

# Vector database (your note embeddings)
/.chroma/

# Environment variables (your API keys)
/.env

# Python virtual environment
/venv/
/.venv/

# Root folder processing files (temporary)
/*.md
!AGENTS.md
/*.m4a
/*.json
/*.pdf
/*.jpg
/*.jpeg
/*.png
/*.wav

# Obsidian (ignore all except essential config)
/.obsidian/*
!/.obsidian/app.json

# ============================================================
# SYSTEM FILES - Minimal set committed to GitHub
# ============================================================

# What gets committed:
# ✓ .2ndBrain/ - Second Brain system (skills, workflow, setup)
# ✓ AGENTS.md - AI agent guidelines
# ✓ .opencode/opencode.json - Permission settings (ask before actions)
# ✓ .obsidian/app.json - File visibility (show all file types)
# ✓ .gitignore - This file

# Exception: Allow .2ndBrain folder and all contents
!/.2ndBrain/
!/.2ndBrain/**

# Exception: Allow .opencode configuration (sets permission="ask")
!/.opencode/
!/.opencode/opencode.json

# Exception: Allow .obsidian configuration (sets showUnsupportedFiles=true)
!/.obsidian/
!/.obsidian/app.json

# ============================================================
# PYTHON / DEVELOPMENT
# ============================================================

# Python cache
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Distribution / packaging
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Testing
.pytest_cache/
.coverage
.hypothesis/

# ============================================================
# OS / EDITOR
# ============================================================

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~
.directory

# VS Code
.vscode/
*.code-workspace

# Git
/.git/
