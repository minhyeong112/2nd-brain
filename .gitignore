# Second Brain - Git Ignore
# Keeps your personal notes private while sharing the system

# ============================================================
# PERSONAL CONTENT - Never commit
# ============================================================

# Sensitive content at vault root (local LLM only)
/*.md
!AGENTS.md
/.env

# Cloud-LLM-Access content (all user notes gitignored)
/Cloud-LLM-Access/**/*.md
!/Cloud-LLM-Access/AGENTS.md
!/Cloud-LLM-Access/CLAUDE.md

# Media and temp files at root
/*.m4a
/*.json
/*.pdf
/*.jpg
/*.jpeg
/*.png
/*.wav
/*.mp3

# Archive
/.Archive/

# ============================================================
# HIDDEN SYSTEM FILES - Inside Cloud-LLM-Access
# ============================================================

# Vector database (your note embeddings)
/Cloud-LLM-Access/.chroma/

# Environment variables (your API keys)
/Cloud-LLM-Access/.env

# Python virtual environment
/Cloud-LLM-Access/.venv/

# Syncthing
/.stfolder/

# ============================================================
# TECHNOLOGY CONFIGS - Selective commit
# ============================================================

# Obsidian (ignore all except essential config for new users)
/.obsidian/*
!/.obsidian/app.json

# OpenCode (commit config file only)
/.opencode/*
!/.opencode/opencode.json

# ============================================================
# FRAMEWORK - What gets committed
# ============================================================

# What gets committed:
# ✓ Cloud-LLM-Access/.2ndBrain/ - Second Brain system (skills, workflow, setup)
# ✓ AGENTS.md (vault root) - Privacy screening rules
# ✓ Cloud-LLM-Access/AGENTS.md - Quick reference
# ✓ Cloud-LLM-Access/CLAUDE.md - Full cloud LLM instructions
# ✓ Cloud-LLM-Access/*/.gitkeep - Folder structure
# ✓ .opencode/opencode.json - Permission settings
# ✓ .obsidian/app.json - File visibility settings
# ✓ .gitignore - This file
# ✓ .python-version - Python version

# Exception: Allow Cloud-LLM-Access/.2ndBrain folder and all contents
!/Cloud-LLM-Access/.2ndBrain/
!/Cloud-LLM-Access/.2ndBrain/**

# Exception: Allow Cloud-LLM-Access folder structure
!/Cloud-LLM-Access/
!/Cloud-LLM-Access/*/.gitkeep

# Exception: Allow .opencode configuration
!/.opencode/
!/.opencode/opencode.json

# Exception: Allow .obsidian configuration
!/.obsidian/
!/.obsidian/app.json

# ============================================================
# PYTHON / DEVELOPMENT
# ============================================================

# Python cache
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Distribution / packaging
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Testing
.pytest_cache/
.coverage
.hypothesis/

# ============================================================
# OS / EDITOR
# ============================================================

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~
.directory

# VS Code
.vscode/
*.code-workspace

# Git
/.git/
